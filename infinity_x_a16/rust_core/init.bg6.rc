# TECNO SPARK Go 2024 (TECNO-BG6 / Unisoc T606 ums9230)
# Project Infinity X v3.12 (Android 16 QPR2) — v8.0 100% Whole-Rust OS Engine
# Ring-0 #[no_std] Rust + Live Rust eBPF JIT + Wasm Policy Sandbox + LLVM BOLT

on early-init
    mount none /system/etc/vendor_build_bg6.prop /vendor/build.prop bind
    mount none /system/etc/permissions/android.hardware.ram.normal.xml /vendor/etc/permissions/handheld_core_hardware.xml bind
    setprop persist.sys.phh.unisoc_color_transform_workaround 1
    setprop persist.sys.sf.disable_blurs 0
    setprop keystore.module_hash.sent true

on init
    mount none /system/etc/vendor_build_bg6.prop /vendor/build.prop bind
    mount none /system/etc/permissions/android.hardware.ram.normal.xml /vendor/etc/permissions/handheld_core_hardware.xml bind
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.config.low_ram false
    setprop persist.sys.phh.unisoc_color_transform_workaround 1
    setprop persist.sys.sf.disable_blurs 0
    setprop keystore.module_hash.sent true

on post-fs
    mount none /system/etc/vendor_build_bg6.prop /vendor/build.prop bind
    mount none /system/etc/permissions/android.hardware.ram.normal.xml /vendor/etc/permissions/handheld_core_hardware.xml bind
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.config.low_ram false

on post-fs-data
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.config.low_ram false
    setprop persist.sys.phh.unisoc_color_transform_workaround 1
    setprop persist.sys.sf.disable_blurs 0
    setprop keystore.module_hash.sent true
    exec u:r:phhsu_daemon:s0 root root -- /system/bin/bg6_rust_core --perf-boot
    setprop sys.usb.config adb
    start adbd

on boot
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.config.low_ram false
    setprop persist.sys.phh.unisoc_color_transform_workaround 1
    setprop persist.sys.sf.disable_blurs 0
    exec u:r:phhsu_daemon:s0 root root -- /system/bin/bg6_rust_core --perf-boot

on property:sys.boot_completed=1
    setprop persist.sys.phh.unisoc_color_transform_workaround 1
    setprop persist.sys.sf.disable_blurs 0
    setprop persist.sys.override_mock_location true
    start bg6_perf_engine
    start bg6_tune_boot
    start bg6_dt2w_daemon
    start gnss_kernel_engine

service bg6_perf_engine /system/bin/bg6_rust_core --perf-daemon
    class late_start
    user root
    group root system shell readproc
    seclabel u:r:phhsu_daemon:s0

service bg6_dt2w_daemon /system/bin/bg6_rust_core --dt2w-daemon
    class late_start
    user root
    group root system input
    seclabel u:r:phhsu_daemon:s0

service bg6_tune_boot /system/bin/bg6_rust_core --tune-boot
    class late_start
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:phhsu_daemon:s0

service gnss_kernel_engine /system/bin/bg6_rust_core --gnss-daemon
    class late_start
    user root
    group root system shell
    seclabel u:r:phhsu_daemon:s0
