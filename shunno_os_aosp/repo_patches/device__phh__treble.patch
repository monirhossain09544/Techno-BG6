diff --git a/phh-on-boot.sh b/phh-on-boot.sh
old mode 100644
new mode 100755
index d2d5b0a..338cbb8
--- a/phh-on-boot.sh
+++ b/phh-on-boot.sh
@@ -60,3 +60,27 @@ getprop | \
     while read -r svc ;do
         setprop ctl.stop "$svc"
     done
+
+
+# === SUNNO OS ON-BOOT DISPLAY & PROVISIONING GUARD ===
+if [ -e /sys/class/display/dispc0/PQ/cm ]; then
+    chmod 0644 /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+    cat /system/etc/sunno_cm_identity.bin > /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+    chmod 0444 /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+fi
+if [ -e /sys/class/display/dispc0/PQ/disable ]; then
+    echo 1 > /sys/class/display/dispc0/PQ/disable 2>/dev/null || true
+fi
+if [ -e /proc/ankai/shutdown_flag ]; then
+    echo 0 > /proc/ankai/shutdown_flag 2>/dev/null || true
+fi
+settings put system min_refresh_rate 60.0 2>/dev/null || true
+settings put system peak_refresh_rate 60.0 2>/dev/null || true
+settings put global device_provisioned 1 2>/dev/null || true
+settings put secure user_setup_complete 1 2>/dev/null || true
+cmd statusbar add-tile com.sunno.ridertile/.RiderModeTileService 2>/dev/null || true
+for pkg in com.google.android.gms com.android.vending; do
+    for perm in android.permission.ACCESS_FINE_LOCATION android.permission.ACCESS_COARSE_LOCATION android.permission.READ_PHONE_STATE android.permission.GET_ACCOUNTS android.permission.READ_CONTACTS android.permission.WRITE_CONTACTS android.permission.POST_NOTIFICATIONS; do
+        pm grant $pkg $perm 2>/dev/null || true
+    done
+done
diff --git a/phh-on-data.sh b/phh-on-data.sh
old mode 100644
new mode 100755
index 472d16e..232514f
--- a/phh-on-data.sh
+++ b/phh-on-data.sh
@@ -29,3 +29,27 @@ if [ "$vndk" = 28 ];then
     mount $minijailSrc64 /vendor/lib64/libminijail.so
     mount $minijailSrc /vendor/lib/libminijail.so
 fi
+
+
+# === SUNNO OS EARLY-BOOT DISPLAY & PANEL GUARD ===
+if [ -e /sys/class/display/dispc0/PQ/cm ]; then
+    chmod 0644 /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+    cat /system/etc/sunno_cm_identity.bin > /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+    chmod 0444 /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+fi
+if [ -e /proc/ankai/shutdown_flag ]; then
+    echo 0 > /proc/ankai/shutdown_flag 2>/dev/null || true
+fi
+(
+    for i in $(seq 1 60); do
+        if [ -e /sys/class/display/dispc0/PQ/cm ]; then
+            chmod 0644 /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+            cat /system/etc/sunno_cm_identity.bin > /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+            chmod 0444 /sys/class/display/dispc0/PQ/cm 2>/dev/null || true
+        fi
+        if [ -e /proc/ankai/shutdown_flag ]; then
+            echo 0 > /proc/ankai/shutdown_flag 2>/dev/null || true
+        fi
+        sleep 1
+    done
+) </dev/null >/dev/null 2>&1 &
