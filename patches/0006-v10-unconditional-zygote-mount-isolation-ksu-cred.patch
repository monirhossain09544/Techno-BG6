From 265ca4ebbd5b90936ba4cf5a29a5e47bf4b0812e Mon Sep 17 00:00:00 2001
From: builder <builder@linux>
Date: Fri, 13 Nov 2026 13:59:57 +0000
Subject: [PATCH] TECNO-BG6: v10 unconditional Zygote mount isolation +
 ksu_cred

---
 drivers/kernelsu/core_hook.c     | 66 ++++++++++++++++----------------
 drivers/kernelsu/selinux/rules.c |  5 ++-
 2 files changed, 37 insertions(+), 34 deletions(-)

diff --git a/drivers/kernelsu/core_hook.c b/drivers/kernelsu/core_hook.c
index 040f1f787..92fe359ba 100644
--- a/drivers/kernelsu/core_hook.c
+++ b/drivers/kernelsu/core_hook.c
@@ -45,6 +45,7 @@
 #include "kernel_compat.h"
 
 static bool ksu_module_mounted = false;
+static struct cred *ksu_cred = NULL;
 
 extern int handle_sepolicy(unsigned long arg3, void __user *arg4);
 
@@ -490,11 +491,6 @@ static void try_umount(const char *mnt, bool check_mnt, int flags)
 
 int ksu_handle_setuid(struct cred *new, const struct cred *old)
 {
-	// this hook is used for umounting overlayfs for some uid, if there isn't any module mounted, just ignore it!
-	if (!ksu_module_mounted) {
-		return 0;
-	}
-
 	if (!new || !old) {
 		return 0;
 	}
@@ -507,50 +503,50 @@ int ksu_handle_setuid(struct cred *new, const struct cred *old)
 		return 0;
 	}
 
-	if (!is_appuid(new_uid) || is_unsupported_uid(new_uid.val)) {
-		// pr_info("handle setuid ignore non application or isolated uid: %d\n", new_uid.val);
+	uid_t appid = new_uid.val % 100000;
+	bool is_standard_app = (appid >= 10000 && appid <= 19999);
+	bool is_isolated_or_wv = (appid >= 90000 && appid <= 99999) || (appid == 1053);
+
+	if (!is_standard_app && !is_isolated_or_wv) {
 		return 0;
 	}
 
-	if (ksu_is_allow_uid(new_uid.val)) {
-		// pr_info("handle setuid ignore allowed application: %d\n", new_uid.val);
+	if (is_standard_app && ksu_is_allow_uid(new_uid.val)) {
 		return 0;
 	}
 
-	if (!ksu_uid_should_umount(new_uid.val)) {
+	// check old process's selinux context, if it is not zygote, ignore it!
+	if (!is_zygote(old->security)) {
 		return 0;
-	} else {
-#ifdef CONFIG_KSU_DEBUG
-		pr_info("uid: %d should not umount!\n", current_uid().val);
-#endif
 	}
 
-	// check old process's selinux context, if it is not zygote, ignore it!
-	// because some su apps may setuid to untrusted_app but they are in global mount namespace
-	// when we umount for such process, that is a disaster!
-	bool is_zygote_child = is_zygote(old->security);
-	if (!is_zygote_child) {
-		pr_info("handle umount ignore non zygote child: %d\n",
-			current->pid);
+	// never unmount in the global init mount namespace
+	if (!current->nsproxy || current->nsproxy->mnt_ns == init_nsproxy.mnt_ns) {
 		return 0;
 	}
-#ifdef CONFIG_KSU_DEBUG
-	// umount the target mnt
-	pr_info("handle umount for uid: %d, pid: %d\n", new_uid.val,
-		current->pid);
-#endif
 
-	// fixme: use `collect_mounts` and `iterate_mount` to iterate all mountpoint and
-	// filter the mountpoint whose target is `/data/adb`
-	try_umount("/system", true, 0);
-	try_umount("/vendor", true, 0);
-	try_umount("/product", true, 0);
-	try_umount("/data/adb/modules", false, MNT_DETACH);
+	const struct cred *saved = NULL;
+	if (ksu_cred) {
+		saved = override_creds(ksu_cred);
+	}
 
-	// try umount ksu temp path
+	// Always detach KernelSU / ramdisk mounts for non-root Zygote children
+	try_umount("/data/adb/modules", false, MNT_DETACH);
 	try_umount("/debug_ramdisk", false, MNT_DETACH);
 	try_umount("/sbin", false, MNT_DETACH);
 
+	if (ksu_module_mounted && (!is_standard_app || ksu_uid_should_umount(new_uid.val))) {
+		try_umount("/system", true, 0);
+		try_umount("/vendor", true, 0);
+		try_umount("/product", true, 0);
+		try_umount("/system_ext", true, 0);
+		try_umount("/odm", true, 0);
+	}
+
+	if (saved) {
+		revert_creds(saved);
+	}
+
 	return 0;
 }
 
@@ -848,6 +844,10 @@ void __init ksu_lsm_hook_init(void)
 
 void __init ksu_core_init(void)
 {
+	ksu_cred = prepare_kernel_cred(NULL);
+	if (!ksu_cred) {
+		pr_err("prepare_kernel_cred failed!\n");
+	}
 	ksu_lsm_hook_init();
 }
 
diff --git a/drivers/kernelsu/selinux/rules.c b/drivers/kernelsu/selinux/rules.c
index a828c151c..78aad3e63 100644
--- a/drivers/kernelsu/selinux/rules.c
+++ b/drivers/kernelsu/selinux/rules.c
@@ -90,8 +90,11 @@ void apply_kernelsu_rules()
 	ksu_allow(db, "init", "adb_data_file", "file", ALL);
 	ksu_allow(db, "init", "adb_data_file", "dir", ALL); // #1289
 	ksu_allow(db, "init", KERNEL_SU_DOMAIN, ALL, ALL);
-	// we need to umount modules in zygote
+	// we need to umount modules in zygote / ksu_cred
 	ksu_allow(db, "zygote", "adb_data_file", "dir", "search");
+	ksu_allow(db, "kernel", ALL, "filesystem", "unmount");
+	ksu_allow(db, "kernel", ALL, "dir", "search");
+	ksu_allow(db, "kernel", ALL, "dir", "getattr");
 
 	// copied from Magisk rules
 	// suRights
-- 
2.43.0
