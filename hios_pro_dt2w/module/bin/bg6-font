#!/system/bin/sh
FONT_DIR="/data/typeface/default"
mkdir -p "$FONT_DIR"

refresh_ui() {
    CUR=$(settings get system font_scale)
    [ -z "$CUR" ] || [ "$CUR" = "null" ] && CUR=1.0
    settings put system font_scale 1.0001
    sleep 1
    settings put system font_scale "$CUR"
}

case "$1" in
    list|"")
        echo "Current active font: $(getprop persist.vendor.sys.os.typeface.defaultfont.hash)"
        echo "Available fonts in $FONT_DIR:"
        ls -1 "$FONT_DIR"
        echo ""
        echo "Usage:"
        echo "  bg6-font set TransSansVF.ttf   (Official HiOS 13 Pro Variable Sans)"
        echo "  bg6-font set ArialMTPro.ttf    (Arial MT Pro Medium)"
        echo "  bg6-font set SourceSansPro.ttf (Source Sans Pro)"
        echo "  bg6-font set NotoSerif.ttf     (Noto Serif)"
        echo "  bg6-font set CarroisGothic.ttf (Carrois Gothic)"
        echo "  bg6-font set DancingScript.ttf (Dancing Script Cursive)"
        echo "  bg6-font set ComingSoon.ttf    (Coming Soon Handwritten)"
        echo "  bg6-font set /sdcard/MyFont.ttf (Any custom .ttf file)"
        echo "  bg6-font reset                 (Restore stock Roboto)"
        ;;
    reset|default|roboto)
        setprop persist.vendor.sys.os.typeface.defaultfont.hash ""
        cmd overlay disable com.android.theme.font.notoserifsource 2>/dev/null
        refresh_ui
        echo "Restored default Roboto font."
        ;;
    set)
        TARGET="$2"
        if [ -f "$TARGET" ]; then
            BASENAME=$(basename "$TARGET")
            cp "$TARGET" "$FONT_DIR/$BASENAME"
            chown system:system "$FONT_DIR/$BASENAME"
            chmod 0644 "$FONT_DIR/$BASENAME"
            restorecon "$FONT_DIR/$BASENAME" 2>/dev/null
            TARGET="$BASENAME"
        fi
        if [ ! -f "$FONT_DIR/$TARGET" ]; then
            echo "Error: Font $TARGET not found in $FONT_DIR"
            exit 1
        fi
        setprop persist.vendor.sys.os.typeface.defaultfont.hash "$TARGET"
        refresh_ui
        echo "Applied system-wide font: $TARGET"
        ;;
esac
