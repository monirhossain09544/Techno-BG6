ro.product.system_ext.brand=google
ro.product.system_ext.device=tdgsi_arm64_ab
ro.product.system_ext.manufacturer=google
ro.product.system_ext.model=Infinity X GSI TrebleDroid
ro.product.system_ext.name=infinity_gsi
ro.system_ext.build.date=Sun Sep 20 21:26:06 UTC 2026
ro.system_ext.build.date.utc=1789939566
