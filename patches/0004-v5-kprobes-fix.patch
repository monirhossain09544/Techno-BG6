index 000000000..3639edc21
--- /dev/null
+++ b/drivers/kernelsu/ksu.c
@@ -0,0 +1,100 @@
+#include <linux/export.h>
+#include <linux/fs.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/workqueue.h>
+
+#include "allowlist.h"
