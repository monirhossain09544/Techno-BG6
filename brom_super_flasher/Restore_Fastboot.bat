@echo off
title TECNO BG6 - Restore via Fastboot / Fastbootd
echo ============================================================
echo   TECNO SPARK GO 2024 (BG6) - FASTBOOT RESTORE SCRIPT
echo ============================================================
echo.
echo Connect phone in Fastboot or Fastbootd mode.
pause

echo Flashing boot_a from boot_a.bin ...
fastboot flash boot_a boot_a.bin
echo Flashing boot_b from boot_b.bin ...
fastboot flash boot_b boot_b.bin
echo Flashing vendor_boot_a from vendor_boot_a.img ...
fastboot flash vendor_boot_a vendor_boot_a.img
echo Flashing vendor_boot_b from vendor_boot_b.img ...
fastboot flash vendor_boot_b vendor_boot_b.img
echo Flashing init_boot_a from init_boot_a.img ...
fastboot flash init_boot_a init_boot_a.img
echo Flashing init_boot_b from init_boot_b.img ...
fastboot flash init_boot_b init_boot_b.img
echo Flashing dtbo_a from dtbo_a.img ...
fastboot flash dtbo_a dtbo_a.img
echo Flashing dtbo_b from dtbo_b.img ...
fastboot flash dtbo_b dtbo_b.img
echo Flashing vbmeta_a from vbmeta_a.img ...
fastboot flash vbmeta_a vbmeta_a.img
echo Flashing vbmeta_b from vbmeta_b.img ...
fastboot flash vbmeta_b vbmeta_b.img
echo Flashing vbmeta_system_a from vbmeta_system_a.img ...
fastboot flash vbmeta_system_a vbmeta_system_a.img
echo Flashing vbmeta_vendor_a from vbmeta_vendor_a.img ...
fastboot flash vbmeta_vendor_a vbmeta_vendor_a.img
echo Flashing vbmeta_product_a from vbmeta_product_a.img ...
fastboot flash vbmeta_product_a vbmeta_product_a.img
echo Flashing vbmeta_system_ext_a from vbmeta_system_ext_a.img ...
fastboot flash vbmeta_system_ext_a vbmeta_system_ext_a.img

if exist super.img (
    echo Flashing super.img...
    fastboot flash super super.img
) else (
    echo [NOTE] To flash super, first run Merge_Super_to_NTFS.bat to generate super.img
)

echo [*] Fastboot restore complete! Rebooting...
fastboot reboot
pause
