ro.system_ext.build.version.release_or_codename=16
ro.system_ext.build.version.sdk=36
ro.system_ext.build.version.sdk_full=36.1
####################################
# from build/make/target/board/gsi_system_ext.prop
####################################
# GSI always generate dex pre-opt in system image
ro.cp_system_other_odex=0
# GSI disables non-AOSP nnapi extensions on product partition
ro.nnapi.extensions.deny_on_product=true
# TODO(b/120679683): disable RescueParty before all problem apps solved
persist.sys.disable_rescue=true
# TODO(b/78105955): disable privapp_permissions checking before the bug solved
ro.control_privapp_permissions=disable
####################################
# from variable PRODUCT_SYSTEM_EXT_PROPERTIES
####################################
ro.config.isolated_compilation_enabled=true
ro.adb.secure=0
ro.sf.blurs_are_expensive=1
ro.surface_flinger.supports_background_blur=1
ro.launcher.blur.appLaunch=0
ro.face.sense_service=true
persist.arm64.memtag.app.com.android.se=off
persist.arm64.memtag.app.com.google.android.bluetooth=off
persist.arm64.memtag.app.com.android.nfc=off
persist.arm64.memtag.process.system_server=off
dalvik.vm.dex2oat64.enabled=true
debug.sf.frame_rate_multiple_threshold=60
# Auto-added by post_process_props.py
persist.sys.usb.config=mtp,adb
# end of file
ro.config.low_ram=false
ro.com.google.acsa=true
ro.opa.eligible_device=true
persist.sys.phh.unisoc_color_transform_workaround=1

# TECNO SmartCaller Call Recording
ro.os.dialer_all_call_record=1
ro.os.all_call_record=1
persist.sys.sf.disable_blurs=0
